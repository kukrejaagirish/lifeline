# Life-Line server configuration
# Copy this file to ".env" (same folder as server.py) and fill in your values.
# Real environment variables always take priority over this file.

# --- Twilio SMS / WhatsApp (optional) ---
# Get these from https://console.twilio.com
# LIFELINE_TWILIO_SID   = ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx (Account SID)
# LIFELINE_TWILIO_AUTH  = your auth token
# LIFELINE_TWILIO_FROM  = +15551234567  (your Twilio number, E.164)
#                         or whatsapp:+14155238886 (Twilio WhatsApp sandbox)
#
# Notes:
# * Trial accounts can only text VERIFIED numbers - verify your phone in the
#   Twilio console first.
# * For the WhatsApp sandbox, the recipient must first send the join code
#   shown in the console to the sandbox number.
# * Without these three values, dispatch is logged as "simulated".

# --- AI Triage via Groq (optional) ---
# Get a key from https://console.groq.com/keys
# LIFELINE_GROQ_KEY   = gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LIFELINE_GROQ_MODEL = llama-3.3-70b-versatile   (optional, this is the default)
#
# Without a key, /api/triage still works - it falls back to an offline
# keyword heuristic and reports "mode": "heuristic" in its response so the
# UI can show honestly whether a suggestion came from AI or the fallback.

# --- Tuning (all optional) ---
# LIFELINE_SLA_REGISTER_MIN = 10     # min before REGISTERED cases auto-escalate
# LIFELINE_DELAY_GRACE_MIN  = 10     # grace minutes past ETA before DELAYED
# LIFELINE_RATE_LIMIT       = 120    # POST requests per minute per IP

# --- Sign-in ---
# LIFELINE_OPEN_LOGIN=1        # 1 = demo: new non-privileged IDs self-register; 0 = registered IDs only
# LIFELINE_SINGLE_SESSION=1    # one live session per operator ID (re-login signs the old one out)
# LIFELINE_DEMO_PIN=1234       # PIN set for CMD-01 / ADMIN-001 on first boot. CHANGE IT.

# --- IoT (Raspberry Pi ambulance kit) ---
# LIFELINE_DEMO_DEVICE_KEY=demo-pi-key-1024   # key for the demo device PI-AMB-1024. CHANGE IT.
# LIFELINE_IOT_MIN_INTERVAL_S=0.5             # min seconds between readings per device

# Network deployments should use TLS:
# python server.py --host 0.0.0.0 --port 8787 --certfile server.crt --keyfile server.key
